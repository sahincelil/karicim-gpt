# Server-side AI provider. Never put these in index.html or app.js.
AI_PROVIDER=auto

# Optional providers. Keep real secrets out of Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
XAI_API_KEY=

# Public URL / server
APP_URL=https://YOUR-DEPLOYMENT-DOMAIN
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Persistent local memory
DATA_DIR=./data
# MEMORY_FILE=./data/memory.json

# Protects the /api/memory endpoint. Use a long random value in production.
BODY_ADMIN_TOKEN=
