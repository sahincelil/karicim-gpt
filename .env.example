# Server-side AI provider. Never put these in index.html or app.js.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: pin a specific currently-free OpenRouter model. Otherwise the free router chooses one.
OPENROUTER_MODEL=openrouter/free
APP_URL=https://YOUR-DEPLOYMENT-DOMAIN

# Alternative paid/provider path:
# AI_PROVIDER=xai
# XAI_API_KEY=xai-...
