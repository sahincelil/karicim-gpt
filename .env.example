# Server-side AI provider. Never put these in index.html or app.js.
AI_PROVIDER=auto

# Optional providers. Keep real secrets out of Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
XAI_API_KEY=

# Public URL / server
APP_URL=https://YOUR-DEPLOYMENT-DOMAIN
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Persistent local memory
DATA_DIR=./data
# MEMORY_FILE=./data/memory.json

# Protects the /api/memory endpoint. Use a long random value in production.
BODY_ADMIN_TOKEN=

# Binance bridge (optional; read-only account access only)
# Create a dedicated Binance key with Enable Reading ONLY. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Separate long random token; keep server-side and never expose it in frontend code.
BINANCE_BRIDGE_TOKEN=
# Optional; leave unset for official Binance Spot API.
# BINANCE_API_BASE_URL=https://api.binance.com
